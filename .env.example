# ─────────────────────────────────────────────────────────────
# Deycid configuration
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Agent wallet private key (0x-prefixed, 32-byte hex).
# Used ONLY to sign x402 payment authorizations for Telegraph inference.
# Use a BURNER wallet funded with a small amount of Base Sepolia USDC.
# `TELEGRAPH_EVM_PRIVATE_KEY` is accepted as an alias (the name the official
# Telegraph MCP server uses); AGENT_PRIVATE_KEY takes precedence.
AGENT_PRIVATE_KEY=

# Telegraph node URLs. Defaults target the public testnet node.
# TELEGRAPH_NODE_URL is used bare (e.g. /api/miners).
# TELEGRAPH_ENGINE_URL is used bare after the /engine prefix (e.g. /v1/ask).
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine

# CAIP-2 network Deycid will pay on, and the USDC asset it expects there.
# Base Sepolia is what the Telegraph testnet node bills against.
TELEGRAPH_PAYMENT_NETWORK=eip155:84532

# Hard per-call ceiling handed to the x402 client's spend controls.
# A single Telegraph call floors at $0.01 and rises with a demand multiplier;
# this is the absolute stop, independent of a case's own budget.
MAX_PAYMENT_PER_CALL_USDC=0.05

# Timeout applied to every outbound Telegraph request, in milliseconds.
TELEGRAPH_REQUEST_TIMEOUT_MS=45000

# Decision defaults. Any of these can be overridden per case via the MCP tool.
DEFAULT_CONFIDENCE_THRESHOLD=0.90
DEFAULT_INTELLIGENCE_BUDGET_USDC=0.10
DEFAULT_MAX_ROUNDS=3

# error | warn | info | debug
LOG_LEVEL=info

# Where to record this installation's Telegraph usage, as append-only JSONL.
# Telegraph keys Signals to the paying wallet and offers no public way to list
# them per wallet, so a self-hosted app has to keep its own record.
# Written locally and NEVER transmitted by Deycid. Set to "off" to disable.
# Default: ~/.deycid/usage.jsonl
DEYCID_USAGE_LOG=

# ── Public demo server (npm run web) — optional ──────────────────────────────
# Only needed if you host the browser demo. It pays for strangers' runs from
# AGENT_PRIVATE_KEY, so these caps are the brakes on that spend.
DEYCID_WEB_PORT=8080
DEYCID_WEB_PER_REQUEST_BUDGET_USDC=0.08
DEYCID_WEB_DAILY_BUDGET_USDC=2.00
DEYCID_WEB_RATE_LIMIT_PER_HOUR=3
