{
  "name": "deycid",
  "version": "0.1.0",
  "description": "Deycid — an intelligence decision layer for autonomous agents. Buys verified Telegraph intelligence until a decision reaches its confidence target or its budget runs out.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "telegraph",
    "telegraph-protocol",
    "x402",
    "base",
    "usdc",
    "ai-agent",
    "autonomous-agents",
    "decision-intelligence",
    "onchain",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sniperchief/Deycid.git"
  },
  "homepage": "https://github.com/sniperchief/Deycid#readme",
  "bugs": {
    "url": "https://github.com/sniperchief/Deycid/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "deycid": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "viem": "^2.56.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
