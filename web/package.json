{
  "name": "deycid-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deycid marketing / product frontend — builds to a single static HTML file consumed by the demo server at src/web/public/index.html.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/publish.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
